// SafeNet Parent Control — Firestore Security Rules
// Deploy: firebase deploy --only firestore:rules
//
// Prinsiplar:
//   1. Parent faqat o'ziga ulangan childrenni ko'radi
//   2. Child faqat o'z parent(lar)i bilan bog'lana oladi
//   3. Notification faqat parentUid egasi ko'radi
//   4. Verification code faqat parent yaratadi, faqat egasi read qiladi
//   5. Users doc: har kim o'z profile'ini yozadi; boshqalarniki read faqat munosabat orqali

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function myUid() {
      return request.auth.uid;
    }
    // Parent shu childUid'ga ega bo'lgan relationship'i bormi
    function isMyChild(childUid) {
      return isSignedIn() && exists(/databases/$(database)/documents/relationships/$(myUid() + '_' + childUid))
        && get(/databases/$(database)/documents/relationships/$(myUid() + '_' + childUid)).data.status == 'active';
    }
    // Child shu parentUid'ga ega bo'lgan relationship'i bormi
    function isMyParent(parentUid) {
      return isSignedIn() && exists(/databases/$(database)/documents/relationships/$(parentUid + '_' + myUid()))
        && get(/databases/$(database)/documents/relationships/$(parentUid + '_' + myUid())).data.status == 'active';
    }

    // ============================================================
    // USERS
    // Har kim o'z profile'ini yozadi.
    // Boshqalarniki faqat munosabat orqali (parent-child).
    // Email orqali izlash uchun `usersByEmail` alohida index collection'i.
    // ============================================================
    match /users/{uid} {
      allow read: if isSelf(uid) || isMyChild(uid) || isMyParent(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    // Email → uid index (child qidirish uchun)
    // Faqat o'zi qo'shadi (create), o'chirmaydi
    match /usersByEmail/{emailKey} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == myUid()
        && request.resource.data.email == request.auth.token.email;
      allow update: if isSignedIn() && resource.data.uid == myUid();
      allow delete: if false;
    }

    // ============================================================
    // RELATIONSHIPS
    // ID format: {parentUid}_{childUid}
    // status: 'pending' | 'active' | 'revoked'
    //
    // Yaratish: parent (pending sifatida)
    // Faollashtirish: child o'zi tomonidan (verification code orqali)
    // Ko'rish: parent yoki child
    // ============================================================
    match /relationships/{relId} {
      allow read: if isSignedIn()
        && (resource.data.parentUid == myUid() || resource.data.childUid == myUid());

      // Parent 'pending' relationship yaratadi
      allow create: if isSignedIn()
        && request.resource.data.parentUid == myUid()
        && request.resource.data.status == 'pending'
        && relId == (request.resource.data.parentUid + '_' + request.resource.data.childUid);

      // Child o'zi tomon faollashtiradi (pending → active)
      allow update: if isSignedIn()
        && resource.data.childUid == myUid()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'active'
        && request.resource.data.parentUid == resource.data.parentUid
        && request.resource.data.childUid == resource.data.childUid;

      // Ikkovi ham revoke qila oladi
      allow delete: if isSignedIn()
        && (resource.data.parentUid == myUid() || resource.data.childUid == myUid());
    }

    // ============================================================
    // VERIFICATION CODES
    // Child email uchun 6-xonali kod, TTL 10 daqiqa.
    //
    // Yaratish: parent (child uchun)
    // Read: child o'zi (verify qilish uchun) yoki parent
    // Update: child (used=true qilish) yoki parent
    // ============================================================
    match /verificationCodes/{codeId} {
      allow read: if isSignedIn()
        && (resource.data.parentUid == myUid() || resource.data.childEmail == request.auth.token.email);
      allow create: if isSignedIn()
        && request.resource.data.parentUid == myUid()
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.used == false;
      allow update: if isSignedIn()
        && (resource.data.parentUid == myUid() || resource.data.childEmail == request.auth.token.email);
      allow delete: if isSignedIn() && resource.data.parentUid == myUid();
    }

    // ============================================================
    // NOTIFICATIONS
    // Parent tomonga signal (child'ning bloklangan qidiruvi).
    //
    // Yaratish: child (o'z uchun) — parent'ga yuboriladi
    // Read: parent (o'ziga tegishlisini)
    // Update: parent (read=true qilish uchun)
    // ============================================================
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.parentUid == myUid();

      // Child o'z uchun notification yaratadi (uni parentUid egasi ko'radi)
      allow create: if isSignedIn()
        && request.resource.data.childUid == myUid()
        && isMyParent(request.resource.data.parentUid)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.read == false;

      // Parent read=true qila oladi
      allow update: if isSignedIn()
        && resource.data.parentUid == myUid()
        && request.resource.data.parentUid == resource.data.parentUid
        && request.resource.data.childUid == resource.data.childUid;

      // Parent o'chira oladi
      allow delete: if isSignedIn() && resource.data.parentUid == myUid();
    }
  }
}
