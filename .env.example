# AI: faqat Groq / OpenRouter / Gemini (Supabase Edge ishlatilmaydi)
USE_DIRECT_AI=1

GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.0-flash
GEMINI_VIDEO_MODEL=gemini-2.0-flash

AI_PROVIDER_ORDER=groq,openrouter,gemini

API_TIMEOUT_MS=28000

OPENROUTER_SITE_URL=https://localhost
OPENROUTER_APP_NAME=NIEX Browser

# ============================================================
# GOOGLE OAUTH — REMOVED: Firebase Authentication is used instead
# ============================================================
# Native Google OAuth Desktop PKCE has been REMOVED.
# The app now uses ONLY Firebase Authentication (signInWithPopup).
# No GOOGLE_CLIENT_ID or GOOGLE_CLIENT_SECRET is required.
#
# If you previously had Desktop OAuth credentials, they are no longer needed.

# Ixtiyoriy: contentfilter.js / monitor.js ni masofadan yuklash (o'z CDN base URL, oxirida /)
# SAFENET_SCRIPT_UPDATE=1
# SAFENET_SCRIPT_UPDATE_URL=https://example.com/path/to/
